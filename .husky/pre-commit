#!/usr/bin/env sh
echo "Running pre-commit checks..."

# ============================================================================
# STEP 1: Build Check
# ============================================================================
echo "Building TypeScript..."
npm run build || {
  echo "Build failed. Fix compilation errors before committing."
  exit 1
}

# ============================================================================
# STEP 2: Test Suite (unit + feature + database + integration)
# ============================================================================
echo "Running npm test (this may take 2-5 minutes)..."
echo "Not in this hook: npm run test:backend, npm run test:native"
npm test || {
  echo "Tests failed. Fix failures before committing."
  echo "Tip: run 'npm test' locally for details"
  exit 1
}

# ============================================================================
# STEP 3: Migration lock (src/database/migrations vs origin/main)
# ============================================================================
echo "Verifying migration file integrity..."
node scripts/check-migration-lock.js --mode staged || {
  echo "Migration lock failed. See the policy message above."
  exit 1
}

echo "All pre-commit checks passed."
echo "Optional extra suites: npm run test:backend / npm run test:native"
