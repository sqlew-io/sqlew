{
  "name": "@sqlew/pg",
  "description": "sqlew MCP server — PostgreSQL driver only (Cloud / Neon / Prisma-friendly slim install)",
  "version": "5.4.1",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./hooks": "./dist/hooks-api.js"
  },
  "type": "module",
  "bin": {
    "sqlew": "dist/index.js"
  },
  "files": [
    "dist/",
    "!dist/tests/",
    "!dist/**/*.map",
    "!dist/**/*.d.ts",
    "scripts/",
    "assets/",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "prepack": "node ../../scripts/sync-scoped-packages.mjs pg"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sqlew-io/sqlew.git",
    "directory": "packages/pg"
  },
  "bugs": {
    "url": "https://github.com/sqlew-io/sqlew/issues"
  },
  "homepage": "https://github.com/sqlew-io/sqlew#readme",
  "keywords": [
    "sqlew",
    "adr",
    "mcp",
    "postgresql",
    "postgres",
    "neon",
    "prisma"
  ],
  "author": "sqlew-io",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.21.1",
    "chokidar": "^4.0.3",
    "knex": "^3.1.0",
    "pg": "^8.16.3",
    "smol-toml": "^1.4.2",
    "zod": "^4.0.0"
  }
}
